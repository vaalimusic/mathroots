# ==========================================
# MathRoots Production Environment Variables
# ==========================================

# Server Configuration
NODE_ENV=production
PORT=3000
APP_URL="http://localhost:3000"

# PostgreSQL Database (Docker Compose default)
DATABASE_URL="postgresql://postgres:mathroots_secure_pass_2026@localhost:5432/mathroots?sslmode=disable"
DB_USER=postgres
DB_PASSWORD=mathroots_secure_pass_2026
DB_NAME=mathroots

# Security & Authentication
JWT_SECRET="replace_with_a_long_random_secret_token_in_production_2026"

# Google Gemini API Key (Optional: for live AI problem decomposition and custom explanations)
# If omitted, MathRoots seamlessly operates using built-in high-fidelity offline generators.
GEMINI_API_KEY=""
